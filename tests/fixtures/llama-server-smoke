#!/opt/venv/bin/python
"""Small HTTP process used to verify the real container launcher lifecycle."""
import argparse
import json
from pathlib import Path
import signal
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

parser = argparse.ArgumentParser()
parser.add_argument("-m")
parser.add_argument("--host", default="127.0.0.1")
parser.add_argument("--port", type=int)
parser.add_argument("--log-file")
args, _ = parser.parse_known_args()
def emit(message):
    print(message, end="", flush=True)


emit("common_init: fitting params to device memory ...\n"
               "load_tensors: CPU model buffer size = 9000.00 MiB\n"
               "print_info: n_layer = 1\n"
               "load_tensors: layer 0 assigned to device CUDA9\n"
               "load_tensors: layer 1 assigned to device CUDA9\n"
               "common_params_fit_impl: id=0, n_layer=1, n_part=0\n"
               "common_fit_params: fitting params to free memory took 0.1 seconds\n"
               "print_info: n_layer = 2\n"
               "print_info: n_layer_all = 3\n"
               "load_tensors: layer 0 assigned to device CPU, is_swa = 0\n"
               "load_tensors: layer 1 assigned to device CPU, is_swa = 0\n"
               "load_tensors: layer 2 assigned to device CPU, is_swa = 0\n"
               "load_tensors: layer 3 assigned to device CPU, is_swa = 0\n"
               "load_tensors: CPU model buffer size = 1.00 MiB\n"
               "server is listening\n"
               "que start_loop: waiting for new tasks\n")


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        body = {"/health": {"status": "ok"}, "/props": {"default_generation_settings": {"n_ctx": 512}},
                "/v1/models": {"data": [{"id": "smoke"}]}, "/slots": []}.get(self.path, {})
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(body).encode())

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
        emit("slot launch_slot: id 0 | processing task 1\n"
                         "slot print_timing: id 0 | task 1 | prompt eval time = 100.00 ms / 12 tokens\n"
                         "slot print_timing: id 0 | task 1 | eval time = 200.00 ms / 7 tokens\n"
             "slot print_timing: id 0 | task 1 | total time = 300.00 ms / 19 tokens\n")
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream" if body.get("stream") else "application/json")
        self.end_headers()
        if body.get("stream"):
            self.wfile.write(b'data: {"choices":[{"index":0,"delta":{"content":"smoke "}}]}\n\n')
            self.wfile.flush()
            time.sleep(0.2)
            self.wfile.write(b'data: {"choices":[{"index":0,"delta":{"content":"response"},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\n')
        else:
            self.wfile.write(b'{"choices":[{"message":{"content":"smoke response"}}]}')


def stop(*_):
    Path("/data/smoke-stopped").write_text("graceful")
    raise SystemExit(0)


signal.signal(signal.SIGTERM, stop)
ThreadingHTTPServer((args.host, args.port), Handler).serve_forever()
