# Copy to .env and set an existing directory containing your GGUF models.
# Windows: use forward slashes, for example C:/Users/you/Models
MODELS_DIR=./models

# Defaults allow access from other devices on your trusted LAN.
# Set BIND_ADDRESS=127.0.0.1 for access only from this computer.
BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8500
INFERENCE_PORT=8001
PROXY_PORT=8501
# Set 0.0.0.0 to allow proxy clients on your LAN. Enable the proxy in Manage.
PROXY_BIND_ADDRESS=127.0.0.1

# Optional upstream llama.cpp server image (a tag or pinned digest).
# Leave unset to select CUDA normally, or CPU with -f compose.yaml.
# LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
